# Copy these values into a private environment file outside version control or export them in the service manager.
FLARE_BASE_URL=https://dve2.com
AGENT_SHARED_SECRET=use-the-same-32-plus-character-worker-secret
# On macOS, AGENT_SHARED_SECRET may be omitted when the secret is stored under this Keychain service.
AGENT_KEYCHAIN_SERVICE=dve2-smart-clip-agent
SMART_CLIP_API_URL=http://127.0.0.1:7706/v1/ai-cut
AGENT_POLL_INTERVAL_MS=5000
SMART_CLIP_POLL_INTERVAL_MS=3000
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_TRANSFER_TIMEOUT_MS=1800000
